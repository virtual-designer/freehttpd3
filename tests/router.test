#!/bin/sh

set -e

tmp1=`mktemp`
tmp2=`mktemp`
trap 'rm -f "$tmp1" "$tmp2"' EXIT INT TERM

$VALGRIND ./router.test.helper > "$tmp1"
cat > "$tmp2" <<EOF
+ /
  + secret
    + .well-known
      + pki-validation
        - verification-284648262752263.txt
  + secret2
    + .well-known2
      + pki-validation
        - verification-284648262752263.txt
      + pki-validation2
        - verification2-284648262752263.txt
  + test_route
    - path
EOF

test "$(cat "$tmp1")" = "$(cat "$tmp2")"
exit $?
